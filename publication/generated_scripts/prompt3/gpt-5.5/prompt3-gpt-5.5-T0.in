units metal
dimension 3
boundary p p s
atom_style atomic
variable a equal 3.3008
variable gap equal 15.0
variable nx equal 20
variable ny equal 20
variable nz_target equal 40
variable nz_projectile equal 20
variable lx equal ${nx}*${a}
variable ly equal ${ny}*${a}
variable lz_target equal ${nz_target}*${a}
variable lz_projectile equal ${nz_projectile}*${a}
variable z_projectile_lo equal ${lz_target}+${gap}
variable z_projectile_hi equal ${z_projectile_lo}+${lz_projectile}
variable originz equal (${gap}/${a})-floor(${gap}/${a})
lattice bcc ${a} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region box block 0 ${lx} 0 ${ly} 0 ${z_projectile_hi} units box
create_box 1 box
region target_region block 0 ${lx} 0 ${ly} 0 ${lz_target} units box
create_atoms 1 region target_region
lattice bcc ${a} origin 0.0 0.0 ${originz} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region projectile_region block 0 ${lx} 0 ${ly} ${z_projectile_lo} ${z_projectile_hi} units box
create_atoms 1 region projectile_region
mass 1 92.90638
group target region target_region
group projectile region projectile_region
group mobile union target projectile
pair_style eam/fs
pair_coeff * * ../../../potentials/prompt1.potential Nb
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
thermo 1000
thermo_style custom step time temp pe ke etotal press pxx pyy pzz vol
velocity mobile create 300.0 12345 mom yes rot yes dist gaussian
fix equil mobile nvt temp 300.0 300.0 0.1
run 100000
reset_timestep 0
velocity projectile set NULL NULL -20.0 units box sum yes
fix impact mobile nve
dump traj mobile custom 1000 dump.nb_spall.lammpstrj id type x y z vx vy vz
dump_modify traj sort id
run 100000
