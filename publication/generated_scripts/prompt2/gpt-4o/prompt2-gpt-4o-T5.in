# LAMMPS Input Script for Melting of Bulk Ni Sample

# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52
region          my_box block 0 10 0 10 0 10
create_box      1 my_box
create_atoms    1 box

# Potential
pair_style      eam
pair_coeff      * * ../../../potentials/prompt1.potential Ni

# Velocities
velocity        all create 600.0 12345 mom yes rot no dist gaussian

# Simulation Settings
timestep        0.001

# Equilibration and Heating
fix             1 all npt temp 300.0 2500.0 0.1 iso 1.0 1.0 1.0
thermo          100
thermo_style    custom step temp press

# Production Run
run             2200