units metal
dimension 3
boundary p p p
atom_style atomic
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
run_style verlet
variable a equal 3.52
variable tstart equal 300.0
variable tstop equal 2500.0
variable ptarget equal 1.01325
variable nsteps equal 220000
lattice fcc ${a} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 10 10 10
mass 1 58.6934
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Ni
velocity all create 600.0 4928459 dist gaussian mom yes rot yes
thermo 1000
thermo_style custom step time temp press pe ke etotal enthalpy vol lx ly lz
reset_timestep 0
fix 1 all npt temp ${tstart} ${tstop} 0.1 iso ${ptarget} ${ptarget} 1.0
run ${nsteps}
