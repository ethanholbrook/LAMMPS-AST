units           metal
dimension       3
boundary        p p p
atom_style      atomic

lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

mass            1 58.6934


pair_style zero 10.0
pair_coeff * *
mass 1 27

timestep        0.001

velocity        all create 600.0 12345 mom yes rot yes dist gaussian

fix             pbar all npt temp 300.0 2500.0 0.1 iso 1.01325 1.01325 1.0

run 10
