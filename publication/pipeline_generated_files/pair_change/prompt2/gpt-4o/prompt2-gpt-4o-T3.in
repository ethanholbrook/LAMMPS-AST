# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# Potential

pair_style zero 10.0
pair_coeff * *
mass 1 27

# Velocity Initialization
velocity        all create 600 12345 mom yes rot yes dist gaussian

# Thermostat and Barostat
fix             1 all npt temp 300 2500 10 iso 1.0 1.0 1.0

# Production Run
timestep        0.001
run 10
