# LAMMPS input script for melting of bulk Ni sample

# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box
replicate       10 10 10

# Potential

pair_style zero 10.0
pair_coeff * *
mass 1 27

# Initial velocities
velocity        all create 600.0 12345 mom yes dist gaussian

# Equilibration
fix             1 all npt temp 300.0 2500.0 100.0 iso 0.0 0.0 1000.0

# Production Run
timestep        0.001
run 10
