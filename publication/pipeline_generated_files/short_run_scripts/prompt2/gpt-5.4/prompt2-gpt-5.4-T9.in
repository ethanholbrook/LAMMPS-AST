units metal
dimension 3
boundary p p p
atom_style atomic
run_style verlet
variable alat equal 3.52
variable seed equal 4928459
variable tcreate equal 600.0
variable tstart equal 300.0
variable tstop equal 2500.0
variable heating_rate equal 10.0
variable ptarget equal 1.01325
variable dt equal 0.001
variable tdamp equal 0.1
variable pdamp equal 1.0
variable nsteps equal 220000
lattice fcc ${alat}
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 10 10 10
pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
velocity all create ${tcreate} ${seed} dist gaussian mom yes rot no loop geom
timestep ${dt}
reset_timestep 0
thermo 1000
thermo_style custom step atoms temp press pe ke etotal enthalpy vol density
thermo_modify flush yes norm no
fix 1 all npt temp ${tstart} ${tstop} ${tdamp} iso ${ptarget} ${ptarget} ${pdamp}
run 10
