# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# Potential
pair_style      eam
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni

# Miscellaneous
neighbor        2.0 bin
neigh_modify    delay 5

# Production Run
velocity        all create 600.0 82382 mom yes rot yes dist gaussian
fix             1 all npt temp 300.0 2500.0 10.0 iso 1.01325 1.01325 1000.0
timestep        0.001
run 10
