units metal
atom_style atomic
boundary p p p

variable lat equal 1.0
lattice fcc ${lat}

region box block 0 1 0 1 0 1 units lattice
create_box 1 box
create_atoms 1 box
replicate 10 10 10

mass 1 58.693

pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni

neighbor 2.0 bin
neigh_modify delay 10 every 1

timestep 0.001

velocity all create 600.0 12345 mom yes rot yes dist gaussian

thermo 1000
thermo_style custom step temp press etotal pe ke vol

variable tstart equal 300.0
variable tstop  equal 2500.0
variable rate   equal 10.0
variable dt     equal 0.001
variable runtime equal (v_tstop - v_tstart)/v_rate
variable nsteps  equal v_runtime/v_dt
variable Tdamp   equal 1.0
variable Pdamp   equal 10.0

fix 1 all npt temp ${tstart} ${tstop} ${Tdamp} iso 1.0 1.0 ${Pdamp}

run 10
