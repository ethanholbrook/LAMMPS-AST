# Initialization
units metal
dimension 3
boundary p p p
atom_style atomic

# System Construction
lattice fcc 3.52
region box block 0 10 0 10 0 10 units lattice
create_box 1 box
create_atoms 1 box
mass 1 58.6934

# Potential
pair_style eam
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni

# Miscellaneous
velocity all create 600.0 482748 temp
fix 1 all npt temp 300.0 2500.0 10.0 iso 1.0 1.0 10.0

# Production Run
timestep 0.001
thermo 100
thermo_style custom step temp epair etotal press vol
run 10
