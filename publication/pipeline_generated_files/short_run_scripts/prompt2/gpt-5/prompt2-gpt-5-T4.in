units metal
dimension 3
boundary p p p
atom_style atomic
newton on

variable dt equal 0.001
variable Tstart equal 300.0
variable Tend equal 2500.0
variable rate equal 10.0
variable ttotal equal (${Tend}-${Tstart})/${rate}
variable nsteps equal ceil(${ttotal}/${dt})

timestep ${dt}

lattice fcc 3.52
region whole block 0 10 0 10 0 10 units lattice
create_box 1 whole
create_atoms 1 box

mass 1 58.6934

pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni

velocity all create 600.0 12345 mom yes rot yes dist gaussian

thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 100

fix 1 all npt temp ${Tstart} ${Tend} 1.0 iso 1.01325 1.01325 10.0

run 10

unfix 1