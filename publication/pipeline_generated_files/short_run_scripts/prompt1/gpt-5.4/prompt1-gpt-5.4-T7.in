units metal
dimension 3
boundary p p p
atom_style atomic
run_style verlet
lattice fcc 4.05 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 5 5 5
mass 1 26.9815385
pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt1.potential Al
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
velocity all create 300.0 4928459 mom yes rot no dist gaussian
thermo 1000
thermo_style custom step time temp press pe ke etotal enthalpy vol lx ly lz
reset_timestep 0
fix 1 all npt temp 300.0 300.0 0.1 iso 1.01325 1.01325 1.0
run 10
