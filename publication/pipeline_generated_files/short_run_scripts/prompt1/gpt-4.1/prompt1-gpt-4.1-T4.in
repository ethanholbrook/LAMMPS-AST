units           metal

atom_style      atomic

boundary        p p p

lattice         fcc 4.05
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box

mass            1 26.9815385

pair_style      eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt1.potential Al

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001

velocity        all create 300.0 4928459 mom yes rot yes dist gaussian

fix             1 all npt temp 300.0 300.0 0.1 iso 1.01325 1.01325 1.0

run 10
