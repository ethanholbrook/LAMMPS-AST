units metal
dimension 3
boundary p p s
atom_style atomic
variable a equal 3.3008
variable gap equal 15.0
variable xhi equal 20.0*${a}
variable yhi equal 20.0*${a}
variable z_target_hi equal 40.0*${a}
variable z_proj_lo equal -20.0*${a}-${gap}
variable z_proj_hi equal -${gap}
lattice bcc ${a} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region simbox block 0.0 ${xhi} 0.0 ${yhi} ${z_proj_lo} ${z_target_hi} units box
create_box 1 simbox
region target block 0.0 ${xhi} 0.0 ${yhi} 0.0 ${z_target_hi} units box
region projectile block 0.0 ${xhi} 0.0 ${yhi} ${z_proj_lo} ${z_proj_hi} units box
create_atoms 1 region target
create_atoms 1 region projectile
mass 1 92.90638
group target region target
group projectile region projectile
group mobile union target projectile
pair_style eam/fs
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
velocity mobile create 300.0 4928459 mom yes rot yes dist gaussian units box
thermo 1000
thermo_style custom step time temp pe ke etotal press pxx pyy pzz vol
thermo_modify flush yes
fix equil mobile nvt temp 300.0 300.0 0.1
run 10
velocity projectile add 0.0 0.0 20.0 units box
fix impact mobile nve
run 10
