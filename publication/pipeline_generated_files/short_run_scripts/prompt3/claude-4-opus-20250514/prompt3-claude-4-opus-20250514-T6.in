# Initialization
units metal
dimension 3
boundary p p f
atom_style atomic
timestep 0.001

# System Construction
lattice bcc 3.3008
region projectile block 0 20 0 20 0 20
create_box 1 projectile
create_atoms 1 box
mass 1 92.90638

region target block 0 20 0 20 -40 0
create_atoms 1 region target

group projectile region projectile
group target region target

displace_atoms projectile move 0 0 1.5

# Potential
pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

# Miscellaneous
neighbor 2.0 bin
neigh_modify delay 10 check yes

# Production Run
velocity all create 300 12345
fix 1 all nvt temp 300 300 0.1
run 10
unfix 1

velocity projectile set 0.0 0.0 2.0 sum yes

fix 2 all nve
run 10
