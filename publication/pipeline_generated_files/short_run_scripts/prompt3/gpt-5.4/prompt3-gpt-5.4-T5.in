units metal
dimension 3
boundary p p m
atom_style atomic
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
run_style verlet
variable alat equal 3.300
variable nx equal 20
variable ny equal 20
variable nzt equal 40
variable nzp equal 20
variable nzsum equal v_nzt+v_nzp
variable nxhi equal v_nx-1.0e-6
variable nyhi equal v_ny-1.0e-6
variable nzthi equal v_nzt-1.0e-6
variable nzsumhi equal v_nzsum-1.0e-6
variable gap equal 15.0
variable pad equal 50.0
variable tinit equal 300.0
variable dt equal 0.001
variable tdamp equal 0.1
variable vimpact equal -20.0
variable xlen equal v_nx*v_alat
variable ylen equal v_ny*v_alat
variable zlen equal v_nzsum*v_alat+v_gap
variable zmin equal -v_pad
variable zmax equal v_zlen+v_pad
region whole block 0.0 ${xlen} 0.0 ${ylen} ${zmin} ${zmax} units box
create_box 2 whole
lattice bcc ${alat} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region target block 0.0 ${nxhi} 0.0 ${nyhi} 0.0 ${nzthi} units lattice
region projectile0 block 0.0 ${nxhi} 0.0 ${nyhi} ${nzt} ${nzsumhi} units lattice
create_atoms 1 region target
create_atoms 2 region projectile0
group target type 1
group projectile type 2
mass 1 92.90638
mass 2 92.90638
pair_style eam/fs
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb Nb
timestep ${dt}
thermo 1000
thermo_style custom step time temp pe ke etotal lx ly lz atoms
thermo_modify flush yes norm no
velocity all create ${tinit} 123456 mom yes rot no dist gaussian
dump d1 all custom 1000 equilibration.lammpstrj id type x y z vx vy vz
dump_modify d1 sort id
fix f1 all nvt temp ${tinit} ${tinit} ${tdamp}
run 10
reset_timestep 0
velocity target zero linear
velocity projectile zero linear
velocity projectile set NULL NULL ${vimpact} sum yes units box
dump d2 all custom 1000 impact.lammpstrj id type x y z vx vy vz fx fy fz
dump_modify d2 sort id
fix f2 all nve
run 10
