units metal
dimension 3
boundary p p m
atom_style atomic
run_style verlet
variable a equal 3.300
variable nx equal 20
variable ny equal 20
variable nzp equal 20
variable nzt equal 40
variable gap equal 15.0
variable pad equal 50.0
variable lx equal v_nx*v_a
variable ly equal v_ny*v_a
variable lproj equal v_nzp*v_a
variable ltarg equal v_nzt*v_a
variable ztshift equal v_pad+v_lproj+v_gap
variable lz equal 2.0*v_pad+v_lproj+v_gap+v_ltarg
variable Teq equal 300.0
variable tdamp equal 0.1
variable dt equal 0.001
variable neq equal 100000
variable nprod equal 100000
variable vimpact equal 20.0
lattice bcc ${a} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0.0 ${lx} 0.0 ${ly} 0.0 ${lz} units box
create_box 1 whole
region proj0 block 0.0 ${nx} 0.0 ${ny} 0.0 ${nzp} units lattice
region targ0 block 0.0 ${nx} 0.0 ${ny} 0.0 ${nzt} units lattice
create_atoms 1 region proj0
group projectile region proj0
create_atoms 1 region targ0
group target subtract all projectile
pair_style eam/fs
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb
mass 1 92.90637
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep ${dt}
compute ttarget target temp/com
compute tprojectile projectile temp/com
velocity target create ${Teq} 4928459 temp ttarget mom yes rot no dist gaussian
velocity projectile create ${Teq} 9847261 temp tprojectile mom yes rot no dist gaussian
fix eq1 target nvt temp ${Teq} ${Teq} ${tdamp}
fix eq2 projectile nvt temp ${Teq} ${Teq} ${tdamp}
fix_modify eq1 temp ttarget
fix_modify eq2 temp tprojectile
thermo 1000
thermo_style custom step time atoms c_ttarget c_tprojectile pe ke etotal lx ly lz
thermo_modify flush yes lost warn norm no
dump 1 all custom 1000 dump.nb_spall.lammpstrj id type x y z vx vy vz
dump_modify 1 sort id
run 10
velocity target zero linear
velocity projectile zero linear
velocity projectile set 0.0 0.0 ${vimpact} sum yes units box
fix prod all nve
run 10
