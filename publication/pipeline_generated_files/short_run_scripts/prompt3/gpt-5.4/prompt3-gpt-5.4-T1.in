units metal
dimension 3
boundary p p f
atom_style atomic
variable a equal 3.300758
variable gap equal 15.0
variable vac equal 500.0
variable lx equal 20.0*v_a
variable ly equal 20.0*v_a
variable zhi equal 60.0*v_a+v_gap+v_vac
variable Teq equal 300.0
variable dt equal 0.001
variable eqsteps equal 100000
variable prodsteps equal 50000
lattice bcc ${a} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0.0 ${lx} 0.0 ${ly} -${vac} ${zhi} units box
create_box 1 whole
region target_reg block 0.0 19.999 0.0 19.999 0.0 39.999 units lattice
region projectile_reg block 0.0 19.999 0.0 19.999 40.0 59.999 units lattice
create_atoms 1 region target_reg
create_atoms 1 region projectile_reg
group target region target_reg
group projectile region projectile_reg
mass 1 92.90638
pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep ${dt}
run_style verlet
thermo 1000
thermo_style custom step time atoms temp pe ke etotal press pxx pyy pzz lx ly lz
thermo_modify flush yes
velocity all create ${Teq} 123456 mom yes rot no dist gaussian
fix eq all nvt temp ${Teq} ${Teq} 0.1
run 10
velocity projectile set NULL NULL -20.0 sum yes units box
reset_timestep 0
fix prod all nve
run 10
