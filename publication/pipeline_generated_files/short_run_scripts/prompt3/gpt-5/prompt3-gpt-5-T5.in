units metal
dimension 3
boundary p p f
atom_style atomic
newton on

variable a equal 3.300
variable gap equal 15.0
variable gap_lattice equal v_gap/v_a
lattice bcc ${a}

variable zhi equal 60.0+v_gap_lattice
variable zlo_targ equal 20.0+v_gap_lattice
variable zhi_targ equal 60.0+v_gap_lattice

region whole block 0 20 0 20 0 ${zhi} units lattice
create_box 1 whole

region proj block 0 20 0 20 0 20 units lattice
region targ block 0 20 0 20 ${zlo_targ} ${zhi_targ} units lattice

create_atoms 1 region proj
create_atoms 1 region targ

group projectile region proj
group target region targ

pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

timestep 0.001
thermo_style custom step time temp press pe ke etotal
thermo 1000

velocity all create 300.0 4928459 mom yes rot yes dist gaussian
fix nvt_all all nvt temp 300.0 300.0 0.1
variable dt equal 0.001
variable t_equil equal 100.0
variable nequil equal ceil(v_t_equil/v_dt)
run 10
unfix nvt_all

velocity projectile add 0.0 0.0 20.0 sum yes
fix nve_all all nve
variable t_prod equal 100.0
variable nprod equal ceil(v_t_prod/v_dt)
run 10
