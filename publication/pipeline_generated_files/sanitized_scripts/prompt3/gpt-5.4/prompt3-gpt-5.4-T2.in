units metal
dimension 3
boundary p p m
atom_style atomic
run_style verlet
lattice bcc v_aNb orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 v_Lx 0 v_Ly 0 v_zthi units box
create_box 1 whole
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Nb
mass 1 v_massNb
neighbor 2 bin
neigh_modify delay 0 every 1 check yes
region projectile block 0 v_Lx 0 v_Ly 0 v_Lp units box
region target block 0 v_Lx 0 v_Ly v_ztlo v_zthi units box
create_atoms 1 region projectile
create_atoms 1 region target
group projectile region projectile
group target region target
timestep 0.001
velocity all create 300 4928459 mom yes rot no dist gaussian
thermo 1000
thermo_style custom step time atoms temp pe ke etotal pxx pyy pzz lx ly lz
dump traj all custom 1000 nb_spall.lammpstrj id type x y z vx vy vz
dump_modify traj sort id
fix eq all nvt temp 300 300 0.1
run 100000
velocity target zero linear
velocity projectile zero linear
velocity projectile set NULL NULL 20 sum yes units box
reset_timestep 0
fix prod all nve
run 100000
write_data nb_spall_final.data
