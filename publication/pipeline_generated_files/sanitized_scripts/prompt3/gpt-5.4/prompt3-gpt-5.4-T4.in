units metal
dimension 3
boundary p p m
atom_style atomic
run_style verlet
lattice bcc 3.3 origin 0 0 0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 66 0 66 0 279 units box
create_box 1 whole
mass 1 92.90637
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Nb
neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
region target block 0 66 0 66 33 165 units box
region projectile block 0 66 0 66 165 231 units box
create_atoms 1 region target
variable ntarget equal count(all)
group target id 1:v_ntarget
create_atoms 1 region projectile
group projectile subtract all target
thermo 1000
thermo_style custom step time atoms temp pe ke etotal pxx pyy pzz lx ly lz
thermo_modify flush yes norm no
dump traj all custom 1000 nb_spall.lammpstrj id type x y z vx vy vz
dump_modify traj sort id
velocity all create 300 4928459 mom yes rot no dist gaussian
fix eq all nvt temp 300 300 0.1
run 100000
velocity target zero linear
velocity projectile zero linear
velocity projectile add 0 0 -20 units box
reset_timestep 0
fix prod all nve
run 100000
write_data nb_spall_final.data
