units metal
atom_style atomic
boundary p p f
lattice bcc 3.3
region proj_box block 0 20 0 20 0 20
region target_box block 0 20 0 20 21.5 101.5
create_box 2 proj_box
create_atoms 1 region proj_box
create_atoms 2 region target_box
replicate 20 20 20 region proj_box
replicate 20 20 40 region target_box
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Nb Nb
velocity all create 300 12345 mom yes rot no
velocity all set 0 0 2000 sum yes units box
fix 1 all nvt temp 300 300 0.1
timestep 0.001
run 100000
unfix 1
fix 2 all nve
timestep 0.001
run 100000
