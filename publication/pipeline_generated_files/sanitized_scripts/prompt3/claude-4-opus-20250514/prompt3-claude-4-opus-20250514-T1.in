units metal
dimension 3
boundary p p f
atom_style atomic
lattice bcc 3.3008
region projectile block 0 20 0 20 0 20
create_box 1 projectile
create_atoms 1 region projectile
mass 1 92.90638
region target block 0 20 0 20 21.5 61.5
create_atoms 1 region target
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Nb
timestep 0.001
thermo 1000
thermo_style custom step temp pe ke etotal press vol
velocity all create 300 12345
fix 1 all nvt temp 300 300 0.1
run 100000
unfix 1
group projectile_atoms region projectile
velocity projectile_atoms set 0 0 20 sum yes
fix 2 all nve
run 100000
