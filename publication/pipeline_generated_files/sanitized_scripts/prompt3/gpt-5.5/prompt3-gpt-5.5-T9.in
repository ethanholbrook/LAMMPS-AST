units metal
dimension 3
boundary p p s
atom_style atomic
lattice bcc 3.3008 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 20 0 20 0 64.54435288414929 units lattice
create_box 1 whole
region target_region block 0 20 0 20 0 40 units lattice
region projectile_region_initial block 0 20 0 20 40 60 units lattice
create_atoms 1 region target_region
group target region target_region
create_atoms 1 region projectile_region_initial
group projectile region projectile_region_initial
mass 1 92.90638
pair_style eam/fs
pair_coeff * * ../../../potentials/prompt1.potential Nb
neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
thermo 1000
thermo_style custom step time temp pe ke etotal press pxx pyy pzz vol
thermo_modify flush yes
velocity all create 300 4928459 mom yes rot yes dist gaussian
fix equilibration all nvt temp 300 300 0.1
run 100000
velocity projectile set 0 0 -20 sum yes units box
reset_timestep 0
fix production all nve
run 100000
