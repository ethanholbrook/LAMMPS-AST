units metal
dimension 3
boundary p p s
atom_style atomic
lattice bcc 3.3008 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region box block 0 66.016 0 66.016 0 213.048 units box
create_box 1 box
region target_region block 0 66.016 0 66.016 0 132.032 units box
create_atoms 1 region target_region
lattice bcc 3.3008 origin 0 0 0.5443528841492968 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region projectile_region block 0 66.016 0 66.016 147.032 213.048 units box
create_atoms 1 region projectile_region
mass 1 92.90638
group target region target_region
group projectile region projectile_region
group mobile union target projectile
pair_style eam/fs
pair_coeff * * ../../../potentials/prompt1.potential Nb
neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
thermo 1000
thermo_style custom step time temp pe ke etotal press pxx pyy pzz vol
velocity mobile create 300 12345 mom yes rot yes dist gaussian
fix equil mobile nvt temp 300 300 0.1
run 100000
reset_timestep 0
velocity projectile set NULL NULL -20 units box sum yes
fix impact mobile nve
dump traj mobile custom 1000 dump.nb_spall.lammpstrj id type x y z vx vy vz
dump_modify traj sort id
run 100000
