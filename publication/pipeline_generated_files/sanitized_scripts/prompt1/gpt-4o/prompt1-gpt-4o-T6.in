units metal
dimension 3
boundary p p p
atom_style atomic
lattice fcc 4.05
region box block 0 5 0 5 0 5
create_box 1 box
create_atoms 1 box
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Al
neighbor 2 bin
neigh_modify delay 0 every 1
timestep 0.001
thermo 1000
fix 1 all npt temp 300 300 0.1 iso 1 1 1
run 500000
