unfix           nvt_eq

# ---- Apply impact velocity: 2 km/s = 20 Angstrom/ps in -z toward target ----
velocity        proj set 0.0 0.0 -20.0 sum yes units box

# ---- Adiabatic impact: NVE ----
fix             nve_imp all nve
thermo          100
thermo_style    custom step temp pe ke etotal press
run 10
