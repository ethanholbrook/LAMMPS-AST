LAMMPS (22 Jul 2025)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# Spall failure of Nb single crystal under 2 km/s impact
# EAM (Fellinger et al., PRB 2010), metal units

units           metal
atom_style      atomic
boundary        p p s

# Lattice parameter for BCC Nb (Fellinger potential)
variable        a       equal 3.3079
variable        gap     equal 15.0          # 1.5 nm gap, in Angstroms
variable        gap_lat equal ${gap}/${a}   # gap in lattice units
variable        gap_lat equal 15/${a}   
variable        gap_lat equal 15/3.3079   

lattice         bcc ${a} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
lattice         bcc 3.3079 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
Lattice spacing in x,y,z = 3.3079 3.3079 3.3079

# Simulation box: x,y = 20 lattice units (periodic);
# z extended with vacuum so free surfaces don't poke out during shock
region          simbox block 0 20 0 20 -10 80 units lattice
create_box      1 simbox
Created orthogonal box = (0 0 -33.079) to (66.158 66.158 264.632)
  1 by 1 by 1 MPI processor grid

# Target: 20 x 20 x 40 BCC cells along [001]
region          rtarget block 0 20 0 20 0 40 units lattice
create_atoms    1 region rtarget
Created 32400 atoms
  using lattice units in orthogonal box = (0 0 -33.108771) to (66.158 66.158 264.66177)
  create_atoms CPU = 0.001 seconds

# Projectile: 20 x 20 x 20 BCC cells, separated from target by gap (1.5 nm)
variable        pzlo equal 40+${gap_lat}
variable        pzlo equal 40+4.53459899029596
variable        pzhi equal ${pzlo}+20
variable        pzhi equal 44.534598990296+20
region          rproj block 0 20 0 20 ${pzlo} ${pzhi} units lattice
region          rproj block 0 20 0 20 44.534598990296 ${pzhi} units lattice
region          rproj block 0 20 0 20 44.534598990296 64.534598990296 units lattice
create_atoms    1 region rproj
Created 16000 atoms
  using lattice units in orthogonal box = (0 0 -33.108771) to (66.158 66.158 264.66177)
  create_atoms CPU = 0.001 seconds

mass            1 92.90638

group           target region rtarget
32400 atoms in group target
group           proj   region rproj
16000 atoms in group proj

pair_style      eam/alloy
pair_coeff      * * prompt3.potential Nb

# ---- Equilibration: NVT at 300 K for 100 ps (dt = 1 fs) ----
velocity        all create 300.0 12345 mom yes rot yes dist gaussian

timestep        0.001
fix             nvt_eq all nvt temp 300.0 300.0 0.1
thermo          1000
thermo_style    custom step temp pe ke etotal press
run 10
Neighbor list info ...
