# Al NPT equilibration - Ercolessi-Adams EAM (OpenKIM)
# Conditions: 300 K, 1 atm, 500 ps, 5x5x5 FCC supercell

units           metal
atom_style      atomic
boundary        p p p

# Al FCC lattice parameter (Angstroms)
lattice         fcc 4.05
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box

mass            1 26.982

pair_style      eam/alloy
pair_coeff      * * prompt1.potential Al

velocity        all create 300.0 12345 mom yes rot yes dist gaussian

timestep        0.001

# Nose-Hoover NPT: Tdamp=0.1 ps, Pdamp=1.0 ps, 1 atm = 1.01325 bar
fix             1 all npt temp 300.0 300.0 0.1 iso 1.01325 1.01325 1.0

thermo          1000
thermo_style    custom step time temp press pe ke etotal vol

run             500000
