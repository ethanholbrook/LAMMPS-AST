LAMMPS (22 Jul 2025)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# Nb BCC spall simulation
# Projectile (20x20x20 cells) impacts target (20x20x40 cells) at 2 km/s along [001]
# Fellinger et al. EAM potential (Phys. Rev. B 81, 144119, 2010) from OpenKIM

units metal
atom_style atomic
boundary p p s

# Nb BCC lattice parameter for Fellinger potential (Angstroms)
variable a equal 3.3008
# Gap between projectile and target surfaces (1.5 nm = 15 Angstroms)
variable gap equal 15.0

# Derived box dimensions
variable lx equal 20*${a}
variable lx equal 20*3.3008
variable ly equal 20*${a}
variable ly equal 20*3.3008
variable proj_lz equal 20*${a}
variable proj_lz equal 20*3.3008
variable targ_lz equal 40*${a}
variable targ_lz equal 40*3.3008
variable targ_zlo equal ${proj_lz}+${gap}
variable targ_zlo equal 66.016+${gap}
variable targ_zlo equal 66.016+15
variable targ_zhi equal ${proj_lz}+${gap}+${targ_lz}
variable targ_zhi equal 66.016+${gap}+${targ_lz}
variable targ_zhi equal 66.016+15+${targ_lz}
variable targ_zhi equal 66.016+15+132.032

lattice bcc ${a}
lattice bcc 3.3008
Lattice spacing in x,y,z = 3.3008 3.3008 3.3008

region simbox block 0 ${lx} 0 ${ly} 0 ${targ_zhi}
region simbox block 0 66.016 0 ${ly} 0 ${targ_zhi}
region simbox block 0 66.016 0 66.016 0 ${targ_zhi}
region simbox block 0 66.016 0 66.016 0 213.048
create_box 1 simbox
Created orthogonal box = (0 0 0) to (217.90561 217.90561 703.22884)
  1 by 1 by 1 MPI processor grid

# Projectile: z = 0 to proj_lz
region proj_reg block 0 ${lx} 0 ${ly} 0 ${proj_lz}
region proj_reg block 0 66.016 0 ${ly} 0 ${proj_lz}
region proj_reg block 0 66.016 0 66.016 0 ${proj_lz}
region proj_reg block 0 66.016 0 66.016 0 66.016
# Target: z = targ_zlo to targ_zhi (gap separates from projectile)
region targ_reg block 0 ${lx} 0 ${ly} ${targ_zlo} ${targ_zhi}
region targ_reg block 0 66.016 0 ${ly} ${targ_zlo} ${targ_zhi}
region targ_reg block 0 66.016 0 66.016 ${targ_zlo} ${targ_zhi}
region targ_reg block 0 66.016 0 66.016 81.016 ${targ_zhi}
region targ_reg block 0 66.016 0 66.016 81.016 213.048

create_atoms 1 region proj_reg
Created 588259 atoms
  using lattice units in orthogonal box = (0 0 -0.070322884) to (217.90561 217.90561 703.29916)
  create_atoms CPU = 0.030 seconds
create_atoms 1 region targ_reg
Created 1167540 atoms
  using lattice units in orthogonal box = (0 0 -0.070322884) to (217.90561 217.90561 703.29916)
  create_atoms CPU = 0.057 seconds

group projectile region proj_reg
588259 atoms in group projectile
group target region targ_reg
1167540 atoms in group target

mass 1 92.906

pair_style eam/alloy
pair_coeff * * prompt3.potential Nb

timestep 0.001

thermo 1000
thermo_style custom step temp pe ke etotal press vol

# --- Equilibration: NVT at 300 K for 100 ps ---
velocity all create 300.0 12345 mom yes rot yes

fix equil all nvt temp 300.0 300.0 0.1

dump equil all custom 10000 dump.equil.lammpstrj id type x y z vx vy vz

run 10
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 6.75
  ghost atom cutoff = 6.75
  binsize = 3.375, bins = 65 65 209
  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair eam/alloy, perpetual
      attributes: half, newton on
      pair build: half/bin/atomonly/newton
      stencil: half/bin/3d
      bin: standard
