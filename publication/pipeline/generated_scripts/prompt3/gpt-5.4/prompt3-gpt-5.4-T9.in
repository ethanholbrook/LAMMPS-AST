units metal
dimension 3
boundary p p s
atom_style atomic
run_style verlet
variable alat equal 3.3004
variable nx equal 20
variable ny equal 20
variable nzp equal 20
variable nzt equal 40
variable gap equal 15.0
variable tinit equal 300.0
variable dt equal 0.001
variable tdamp equal 0.1
variable vimpact equal 20.0
variable neq equal 100000
variable nprod equal 100000
variable lx equal v_nx*v_alat
variable ly equal v_ny*v_alat
variable pz equal v_nzp*v_alat
variable tz equal v_nzt*v_alat
variable tzlo equal v_pz
variable tzhi equal v_pz+v_tz
variable zhi equal v_pz+v_tz+v_gap+0.1
variable tshift equal v_gap-0.5*v_alat
lattice bcc ${alat} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0.0 ${lx} 0.0 ${ly} -0.1 ${zhi} units box
create_box 1 whole
mass 1 92.90637
region projectile block 0.0 ${lx} 0.0 ${ly} 0.0 ${pz} units box
region target block 0.0 ${lx} 0.0 ${ly} ${tzlo} ${tzhi} units box
create_atoms 1 region projectile
create_atoms 1 region target
group projectile region projectile
group target region target
pair_style eam/fs
pair_coeff * * ../../../potentials/prompt1.potential Nb
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
timestep ${dt}
thermo 1000
thermo_style custom step time atoms temp pe ke etotal press pxx pyy pzz lx ly lz
thermo_modify flush yes
velocity all create ${tinit} 4928459 mom yes rot no dist gaussian loop geom
fix eq all nvt temp ${tinit} ${tinit} ${tdamp}
dump deq all custom 1000 equilibration.lammpstrj id type x y z vx vy vz
dump_modify deq sort id
run ${neq}
reset_timestep 0
velocity projectile add 0.0 0.0 ${vimpact} units box
fix prod all nve
dump dprod all custom 1000 impact.lammpstrj id type x y z vx vy vz
dump_modify dprod sort id
run ${nprod}
