# Initialization
units           metal
atom_style      atomic
boundary        p p f

# System Construction
lattice         bcc 3.300
region          projectile block 0 20 0 20 0 20
region          target block 0 20 0 20 21.5 61.5
region          whole union 2 projectile target
create_box      1 whole
create_atoms    1 region projectile
create_atoms    1 region target

# Potential
pair_style      eam
pair_coeff      * * ../../../potentials/prompt1.potential Nb

# Miscellaneous
mass            1 92.906

# Equilibration
velocity        all create 300.0 12345 mom yes rot no dist gaussian
fix             equil all nvt temp 300.0 300.0 0.1
timestep        0.001
run             100000

unfix           equil

# Apply Impact Velocity
group           projectile region projectile
velocity        projectile add 0.0 0.0 2000.0

# Production Run
fix             nve all nve
run             200000