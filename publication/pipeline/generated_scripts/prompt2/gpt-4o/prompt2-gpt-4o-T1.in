# LAMMPS Input Script: Melting of Bulk Ni Sample

# Initialization
units           metal
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# Potential
pair_style      eam/alloy
pair_coeff      * * ../../../potentials/prompt1.potential Ni

# Miscellaneous
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Initial velocities
velocity        all create 600.0 12345 mom yes rot yes dist gaussian

# Production Run
fix             1 all npt temp 300.0 2500.0 100.0 iso 0.0 0.0 1000.0
timestep        1.0
run             2200