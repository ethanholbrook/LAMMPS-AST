# LAMMPS input script for melting simulation of bulk Ni sample

# Initialization
units metal
dimension 3
boundary p p p
atom_style atomic

# System Construction
lattice fcc 3.52
region box block 0 10 0 10 0 10
create_box 1 box
create_atoms 1 box

# Potential
pair_style eam
pair_coeff * * ../../../potentials/prompt1.potential Ni

# Initial velocities
velocity all create 600.0 12345 mom yes dist gaussian

# Miscellaneous
thermo 100
thermo_style custom step temp press potential energy

# Production Run (Heating from 300 K to 2500 K)
fix 1 all npt temp 300.0 2500.0 100.0 iso 1.0 1.0 1000.0
timestep 0.001
run 22000