# Initialization
units metal
dimension 3
boundary p p p
atom_style atomic

# System Construction
lattice fcc 3.52
region box block 0 10 0 10 0 10
create_box 1 box
create_atoms 1 box
mass 1 58.6934

# Potential
pair_style eam
pair_coeff * * ../../../potentials/prompt1.potential

# Miscellaneous
velocity all create 600.0 12345 dist gaussian
timestep 0.001

# Production Run
fix 1 all npt temp 300.0 2500.0 0.1 iso 1.0 1.0 1.0
thermo 1000
run 220000