# LAMMPS Input Script

# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 4.05
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box

# Potential
pair_style      eam/alloy
pair_coeff      * * ../../../potentials/prompt1.potential Al

# Minimization
minimize        1.0e-4 1.0e-6 100 1000

# Equilibration
timestep        0.001
thermo          100

fix             1 all npt temp 300 300 0.1 iso 1.0 1.0 1.0
run             500000
unfix           1

# End of script