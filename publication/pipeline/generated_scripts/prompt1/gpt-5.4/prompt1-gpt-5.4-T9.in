units metal
dimension 3
boundary p p p
atom_style atomic
variable alat equal 4.05
variable nrep equal 5
variable temperature equal 300.0
variable pressure_atm equal 1.0
variable pressure_bar equal 1.01325*v_pressure_atm
variable tdamp equal 0.1
variable pdamp equal 1.0
variable dt equal 0.001
variable steps equal 500000
variable seed equal 4928459
lattice fcc ${alat}
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate ${nrep} ${nrep} ${nrep}
mass 1 26.9815385
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Al
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
timestep ${dt}
run_style verlet
velocity all create ${temperature} ${seed} mom yes rot no dist gaussian
reset_timestep 0
thermo 1000
thermo_style custom step time temp press pxx pyy pzz pe ke etotal vol lx ly lz
thermo_modify flush yes
fix 1 all npt temp ${temperature} ${temperature} ${tdamp} iso ${pressure_bar} ${pressure_bar} ${pdamp}
run ${steps}
