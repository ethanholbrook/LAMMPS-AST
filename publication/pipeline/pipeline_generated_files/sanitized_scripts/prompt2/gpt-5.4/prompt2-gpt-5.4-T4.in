units metal
dimension 3
boundary p p p
atom_style atomic
run_style verlet
lattice fcc 3.52 origin 0 0 0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region uc block 0 1 0 1 0 1 units lattice
create_box 1 uc
create_atoms 1 box
replicate 10 10 10
mass 1 58.6934
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Ni
neighbor 2 bin
neigh_modify every 1 delay 0 check yes
velocity all create 600 4928459 mom yes rot no dist gaussian
timestep 0.001
reset_timestep 0
thermo 1000
thermo_style custom step time temp press pe ke etotal vol lx ly lz
fix 1 all npt temp 300 2500 0.1 iso 1.01325 1.01325 1
run 220000
write_data ni_melting_final.data
