units metal
dimension 3
boundary p p p
atom_style atomic
lattice fcc 4.05
region prim block 0 1 0 1 0 1 units lattice
create_box 1 prim
create_atoms 1 box
replicate 5 5 5
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Al
velocity all create 300 12345 mom yes rot yes dist gaussian
timestep 0.001
fix 1 all npt temp 300 300 0.1 iso 1.01325 1.01325 1
run 500000
unfix 1
