units metal
dimension 3
boundary p p p
atom_style atomic
lattice fcc 4.05
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 5 5 5
mass 1 26.9815385
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Al
neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
velocity all create 300 12345 mom yes rot no dist gaussian
thermo 1000
thermo_style custom step time temp press pe ke etotal vol lx ly lz
thermo_modify norm no
fix npt_equil all npt temp 300 300 0.1 iso 1.01325 1.01325 1
run 500000
write_data equilibrated_al_npt.data
