units metal
dimension 3
boundary p p f
atom_style atomic
lattice bcc 3.3
region projectile_block block 0 20 0 20 0 20 units lattice
region target_block block 0 20 0 20 21.5 61.5 units lattice
region simulation_box union 2 projectile_block target_block
create_box 1 simulation_box
create_atoms 1 region projectile_block
create_atoms 1 region target_block
pair_style eam
pair_coeff * * ../../../potentials/prompt1.potential Nb
velocity all create 300 12345 mom yes rot yes dist gaussian
velocity projectile_block set 0 0 -2000 units box
fix nvt_equilibration all nvt temp 300 300 0.1
timestep 0.001
run 100000
unfix nvt_equilibration
fix nve_integration all nve
run 500000
