units metal
dimension 3
boundary p p m
atom_style atomic
run_style verlet
neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
region r_whole block 0 66 0 66 0 213 units box
create_box 1 r_whole
mass 1 92.90638
lattice bcc 3.3 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1 origin 0 0 0
region r_target block 0 65.999999 0 65.999999 0 131.999999 units box
create_atoms 1 region r_target
lattice bcc 3.3 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1 origin 0 0 0.5454545454545467
region r_projectile block 0 65.999999 0 65.999999 147 212.999999 units box
create_atoms 1 region r_projectile
group target region r_target
group projectile region r_projectile
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Nb
compute cthermo all temp
thermo 1000
thermo_style custom step time atoms temp pe ke etotal press pxx pyy pzz lx ly lz
thermo_modify temp cthermo flush yes
velocity all create 300 12345 dist gaussian mom yes rot no
fix eq all nvt temp 300 300 0.1
fix_modify eq temp cthermo
run 100000
reset_timestep 0
velocity projectile set 0 0 -20 sum yes
fix prod all nve
run 100000
