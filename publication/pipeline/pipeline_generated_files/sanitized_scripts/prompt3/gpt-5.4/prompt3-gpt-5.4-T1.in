units metal
dimension 3
boundary p p f
atom_style atomic
lattice bcc 3.300758 origin 0 0 0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 66.01516000000001 0 66.01516000000001 -500 713.04548 units box
create_box 1 whole
region target_reg block 0 19.999 0 19.999 0 39.999 units lattice
region projectile_reg block 0 19.999 0 19.999 40 59.999 units lattice
create_atoms 1 region target_reg
create_atoms 1 region projectile_reg
group target region target_reg
group projectile region projectile_reg
mass 1 92.90638
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Nb
neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
run_style verlet
thermo 1000
thermo_style custom step time atoms temp pe ke etotal press pxx pyy pzz lx ly lz
thermo_modify flush yes
velocity all create 300 123456 mom yes rot no dist gaussian
fix eq all nvt temp 300 300 0.1
run 100000
velocity projectile set NULL NULL -20 sum yes units box
reset_timestep 0
fix prod all nve
run 50000
