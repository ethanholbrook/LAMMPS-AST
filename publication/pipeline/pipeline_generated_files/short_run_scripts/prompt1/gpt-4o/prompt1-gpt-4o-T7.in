# Initialization
units metal
dimension 3
boundary p p p
atom_style atomic

# System Construction
lattice fcc 4.05
region box block 0 5 0 5 0 5
create_box 1 box
create_atoms 1 box

# Potential
pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt1.potential Al

# Miscellaneous
neighbor 2.0 bin
neigh_modify delay 5 every 1

# Production Run
timestep 0.001
thermo 100

fix 1 all npt temp 300 300 0.1 iso 1 1 1.0

run 10
