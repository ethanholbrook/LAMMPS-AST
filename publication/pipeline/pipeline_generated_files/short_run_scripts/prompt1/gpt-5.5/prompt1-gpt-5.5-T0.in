units metal
dimension 3
boundary p p p
atom_style atomic
variable a equal 4.05
lattice fcc ${a}
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 5 5 5
mass 1 26.9815385
pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt1.potential Al
neighbor 2.0 bin
neigh_modify every 1 delay 10 check yes
timestep 0.001
reset_timestep 0
velocity all create 300.0 12345 mom yes rot no dist gaussian
fix npt_equil all npt temp 300.0 300.0 0.1 iso 1.01325 1.01325 1.0
thermo 1000
thermo_style custom step time temp press pe ke etotal vol density
run 10
