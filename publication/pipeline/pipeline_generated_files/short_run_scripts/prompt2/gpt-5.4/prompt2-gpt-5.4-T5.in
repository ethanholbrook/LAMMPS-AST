units metal
dimension 3
boundary p p p
atom_style atomic
variable alat equal 3.52
variable tvelocity equal 600.0
variable tstart equal 300.0
variable tstop equal 2500.0
variable tdamp equal 0.1
variable ptarget equal 1.01325
variable pdamp equal 1.0
variable dt equal 0.001
lattice fcc ${alat} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 10 10 10
mass 1 58.6934
pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep ${dt}
velocity all create ${tvelocity} 4928459 mom yes rot no dist gaussian
thermo 1000
thermo_style custom step temp press pe ke etotal vol lx ly lz
thermo_modify flush yes norm no lost error
run_style verlet
reset_timestep 0
fix 1 all npt temp ${tstart} ${tstop} ${tdamp} iso ${ptarget} ${ptarget} ${pdamp}
run 10
