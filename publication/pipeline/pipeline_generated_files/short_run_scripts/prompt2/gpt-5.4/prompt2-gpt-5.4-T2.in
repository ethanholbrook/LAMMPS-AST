units metal
dimension 3
boundary p p p
atom_style atomic
run_style verlet
variable alat equal 3.52
variable tinit equal 600.0
variable tstart equal 300.0
variable tstop equal 2500.0
variable rate equal 10.0
variable ptarget equal 1.01325
variable timestep_size equal 0.001
variable tdamp equal 0.1
variable pdamp equal 1.0
variable runtime equal (v_tstop-v_tstart)/v_rate
variable nsteps equal ceil(v_runtime/v_timestep_size)
lattice fcc ${alat}
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 10 10 10
mass 1 58.6934
pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
velocity all create ${tinit} 12345 mom yes rot no dist gaussian
timestep ${timestep_size}
thermo 1000
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz
thermo_modify flush yes norm no
reset_timestep 0
fix 1 all npt temp ${tstart} ${tstop} ${tdamp} iso ${ptarget} ${ptarget} ${pdamp}
run 10
