# Initialization
units metal
dimension 3
boundary p p p
atom_style atomic

# System Construction
lattice fcc 3.52
region box block 0 10 0 10 0 10
create_box 1 box
create_atoms 1 box
mass 1 58.6934
velocity all create 600.0 12345 dist gaussian

# Potential
pair_style eam
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni

# Miscellaneous
timestep 0.001
thermo 1000
thermo_style custom step temp press pe ke etotal vol

# Production Run
fix 1 all npt temp 300.0 2500.0 0.01 iso 1.0 1.0 0.1
run 10
