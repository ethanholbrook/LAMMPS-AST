label Initialization
units metal
dimension 3
boundary p p p
atom_style atomic
newton on
processors * * *
timestep 0.001

label System_Construction
lattice fcc 3.52
region box block 0 1 0 1 0 1 units lattice
create_box 1 box
create_atoms 1 box
replicate 10 10 10

label Potential
pair_style eam
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni
mass 1 58.6934
neighbor 2.0 bin
neigh_modify delay 10 every 1 check yes
special_bonds lj/coul 0.0 0.0 0.0

label Miscellaneous
velocity all create 600.0 12345 mom yes rot no dist gaussian
thermo_style custom step temp press pe ke etotal vol density
thermo 1000
thermo_modify flush yes
reset_timestep 0

label Production_Run
fix 1 all npt temp 300.0 2500.0 0.1 iso 1.01325 1.01325 1.0
run 10
unfix 1