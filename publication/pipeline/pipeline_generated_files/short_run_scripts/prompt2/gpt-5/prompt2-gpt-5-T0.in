units metal
atom_style atomic
boundary p p p
lattice fcc 3.52
region whole block 0 10 0 10 0 10 units lattice
create_box 1 whole
create_atoms 1 box
mass 1 58.6934
pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni
variable dt equal 0.001
timestep ${dt}
reset_timestep 0
velocity all create 600.0 12345 mom yes rot yes dist gaussian
variable Tstart equal 300.0
variable Tstop equal 2500.0
variable rate equal 10.0
variable nsteps equal ceil((${Tstop}-${Tstart})/(${rate}*${dt}))
fix 1 all npt temp ${Tstart} ${Tstop} 0.1 iso 1.01325 1.01325 1.0
thermo 1000
thermo_style custom step temp press pe ke etotal vol
run 10
