# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52
region          whole block 0 10 0 10 0 10
create_box      1 whole
create_atoms    1 box
replicate       10 10 10

# Potential
pair_style      eam
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni

# Velocities
velocity        all create 600.0 4928459 mom yes rot yes dist gaussian

# Thermo
thermo          100
thermo_style    custom step temp press

# NPT Ensemble
fix             1 all npt temp 300.0 2500.0 0.1 iso 1.0 1.0 1.0

# Production Run
timestep        0.001
run 10
