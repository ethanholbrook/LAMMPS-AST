units metal
dimension 3
boundary p p p
atom_style atomic
variable lat equal 3.52
variable Tvel equal 600.0
variable Tstart equal 300.0
variable Tend equal 2500.0
variable heatrate equal 10.0
variable P equal 1.01325
variable dt equal 0.001
variable Tdamp equal 0.1
variable Pdamp equal 1.0
variable nsteps equal ceil((v_Tend-v_Tstart)/(v_heatrate*v_dt))
lattice fcc ${lat} origin 0.0 0.0 0.0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region unitcell block 0 1 0 1 0 1 units lattice
create_box 1 unitcell
create_atoms 1 box
replicate 10 10 10
mass 1 58.6934
pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
timestep ${dt}
reset_timestep 0
velocity all create ${Tvel} 12345 mom yes rot yes dist gaussian
thermo 1000
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz
thermo_modify flush yes
fix npt_heating all npt temp ${Tstart} ${Tend} ${Tdamp} iso ${P} ${P} ${Pdamp}
run 10
