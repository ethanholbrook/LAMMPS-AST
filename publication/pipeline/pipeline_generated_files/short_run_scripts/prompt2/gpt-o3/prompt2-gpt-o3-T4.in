# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic
timestep        0.001
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# Potential
pair_style      eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni
mass            1 58.6934

# Miscellaneous
velocity        all create 600.0 12345 mom yes dist gaussian
thermo_style    custom step temp press pe ke etotal
thermo          1000
fix             ensemble all npt temp 300.0 2500.0 100.0 iso 1.01325 1.01325 1000.0

# Production Run
run 10
unfix           ensemble