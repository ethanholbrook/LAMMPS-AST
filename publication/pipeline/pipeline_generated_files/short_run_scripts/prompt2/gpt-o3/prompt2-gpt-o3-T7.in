# Initialization
units           metal
atom_style      atomic
boundary        p p p
timestep        0.001
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10 units lattice
create_box      1 box
create_atoms    1 box
mass            1 58.6934

# Potential
pair_style      eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt2.potential Ni

# Miscellaneous
velocity        all create 600.0 12345 mom yes rot no dist gaussian
thermo          1000
thermo_style    custom step temp press pe ke etotal
reset_timestep  0

# Production Run
variable        tdamp equal 0.1
variable        pdamp equal 1.0
fix             1 all npt temp 300.0 2500.0 ${tdamp} iso 1.01325 1.01325 ${pdamp}
variable        total_steps equal 220000
run 10
