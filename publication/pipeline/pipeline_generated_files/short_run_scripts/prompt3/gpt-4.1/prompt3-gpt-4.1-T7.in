# Initialization
units           metal
dimension       3
boundary        p p s
atom_style      atomic

# System Construction
lattice         bcc 3.300
region          projectile block 0 20 0 20 0 20
region          target block 0 20 0 20 21.5 61.5
create_box      1 projectile union target
create_atoms    1 region projectile
create_atoms    1 region target

# Potential
pair_style      eam
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

# Miscellaneous
mass            1 92.906
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Equilibration
velocity        all create 300.0 12345 mom yes rot yes dist gaussian
fix             NVT all nvt temp 300.0 300.0 0.1
timestep        0.001
run 10
unfix           NVT

# Assign Impact Velocity
group           projectile region projectile
velocity        projectile set 0.0 0.0 2000.0 sum yes

# Production Run
fix             NVE all nve
run 10
