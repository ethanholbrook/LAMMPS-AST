# Initialization
units metal
atom_style atomic
boundary p p f

# System Construction
lattice bcc 3.300
region target block 0 20 0 20 0 40
region projectile block 0 20 0 20 41.5 61.5
region whole union 2 target projectile
create_box 1 whole
create_atoms 1 region target
create_atoms 1 region projectile

# Potential
pair_style eam
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

# Miscellaneous
mass 1 92.906

# Production Run
velocity all create 300.0 87287 mom yes rot no dist gaussian
group projectile region projectile
velocity projectile set 0.0 0.0 2000.0 sum yes units box
fix 1 all nve
fix 2 all temp/rescale 1 300.0 300.0 0.01 1.0 region target
timestep 0.001
run 10
unfix 2
run 10
