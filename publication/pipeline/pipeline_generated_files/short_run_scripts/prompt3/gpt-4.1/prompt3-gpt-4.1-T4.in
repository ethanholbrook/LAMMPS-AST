# Initialization
units           metal
atom_style      atomic
boundary        p p f

# System Construction
lattice         bcc 3.300
region          target block 0 66.0 0 66.0 0 132.0
region          projectile block 0 66.0 0 66.0 133.5 199.5
region          whole union 2 target projectile
create_box      1 whole
create_atoms    1 region target
create_atoms    1 region projectile

mass            1 92.90637

# Potential
pair_style      eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

# Miscellaneous
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

velocity        all create 300.0 87287 mom yes rot no dist gaussian

group           projectile region projectile
velocity        projectile set 0.0 0.0 -2000.0 units box

# Production Run
fix             1 all nvt temp 300.0 300.0 0.1
timestep        0.001
run 10

unfix           1
fix             2 all nve
run 10
