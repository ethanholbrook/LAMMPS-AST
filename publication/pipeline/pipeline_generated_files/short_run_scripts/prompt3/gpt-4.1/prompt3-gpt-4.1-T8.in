# Initialization
units           metal
atom_style      atomic
dimension       3
boundary        p p f

# System Construction
lattice         bcc 3.300
region          projectile block 0 20 0 20 0 20
region          target block 0 20 0 20 20 60
region          simbox union 2 projectile target
create_box      1 simbox
create_atoms    1 region projectile
create_atoms    1 region target

# Gap Insertion
displace_atoms  region projectile move 0.0 0.0 -1.5
change_box      all z final 0 61.5

# Potential
pair_style      eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

# Miscellaneous
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
velocity        all create 300.0 4928459 mom yes rot yes dist gaussian
group           projectile region projectile
group           target region target
velocity        projectile set 0.0 0.0 2000.0 sum yes

# Equilibration
fix             nvt_eq all nvt temp 300.0 300.0 0.1
timestep        0.001
run 10
unfix           nvt_eq

# Production Run
fix             nve all nve
run 10
