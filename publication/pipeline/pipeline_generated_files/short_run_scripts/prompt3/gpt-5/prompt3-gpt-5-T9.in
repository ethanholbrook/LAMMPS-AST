clear
units metal
dimension 3
boundary p p f
atom_style atomic

variable a equal 3.3
variable nx equal 20
variable ny equal 20
variable nz_target equal 40
variable nz_proj equal 20
variable gap equal 15.0

variable lx equal v_nx*v_a
variable ly equal v_ny*v_a
variable zt equal v_nz_target*v_a
variable zp equal v_nz_proj*v_a
variable lz equal v_zt+v_gap+v_zp

lattice bcc ${a} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 ${lx} 0 ${ly} 0 ${lz} units box
create_box 1 whole

region target block 0 ${lx} 0 ${ly} 0 ${zt} units box
variable zplo equal v_zt+v_gap
variable zphi equal v_zplo+v_zp
region projectile block 0 ${lx} 0 ${ly} ${zplo} ${zphi} units box

create_atoms 1 region target
create_atoms 1 region projectile

group target region target
group projectile region projectile

pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

variable dt equal 0.001
timestep ${dt}

thermo 1000
thermo_style custom step time temp press pe ke etotal

velocity target create 300.0 12345 mom yes rot yes dist gaussian
velocity projectile create 300.0 67890 mom yes rot yes dist gaussian

fix ft target nvt temp 300.0 300.0 0.1
fix fp projectile nvt temp 300.0 300.0 0.1

variable teq equal 100.0
variable nsteq equal v_teq/v_dt
run 10

unfix ft
unfix fp

velocity projectile add 0.0 0.0 -20.0 sum yes

fix fa all nve

variable tprod equal 200.0
variable nsteps equal v_tprod/v_dt
run 10
