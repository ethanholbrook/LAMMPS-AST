label Initialization
units metal
dimension 3
atom_style atomic
boundary p p f
newton on

label System_Construction
variable a equal 3.3
variable nx equal 20
variable ny equal 20
variable nz_t equal 40
variable nz_p equal 20
variable gap equal 15.0
variable lx equal ${nx}*${a}
variable ly equal ${ny}*${a}
variable lzt equal ${nz_t}*${a}
variable lzp equal ${nz_p}*${a}
variable lz equal ${lzt}+${gap}+${lzp}
region whole block 0 ${lx} 0 ${ly} 0 ${lz} units box
create_box 1 whole
lattice bcc ${a}
region target block 0 ${lx} 0 ${ly} 0 ${lzt} units box
region projectile block 0 ${lx} 0 ${ly} ${lzt}+${gap} ${lz} units box
create_atoms 1 region target
create_atoms 1 region projectile
group target region target
group projectile region projectile

label Potential
pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

label Miscellaneous
variable dt equal 0.005
timestep ${dt}
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
thermo 1000
thermo_style custom step time temp pe ke etotal press lx ly lz
velocity all create 300.0 12345 mom yes rot yes dist gaussian

label Production_Run
fix eq all nvt temp 300.0 300.0 0.1
variable teq equal 100.0
variable nequil equal ceil(${teq}/${dt})
run 10
unfix eq
reset_timestep 0
variable vimp equal 20.0
velocity projectile add 0.0 0.0 -${vimp} sum yes
fix prod all nve
variable tprod equal 200.0
variable nprod equal ceil(${tprod}/${dt})
run 10
