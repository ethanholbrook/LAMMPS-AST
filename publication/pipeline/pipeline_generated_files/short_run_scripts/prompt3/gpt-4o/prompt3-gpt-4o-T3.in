# Initialization
units           metal
dimension       3
boundary        p p f
atom_style      atomic

# System Construction
lattice         bcc 3.3
region          projectile block 0 20 0 20 0 20
region          target block 0 20 0 20 21.5 61.5
create_box      2 projectile
create_atoms    1 region projectile
create_atoms    2 region target

# Potential
pair_style      eam
pair_coeff * * /home/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb Nb

# Velocities and Equilibration
velocity        all create 300.0 12345
fix             1 all nvt temp 300.0 300.0 0.1
run 10

# Production Run
unfix           1
velocity        projectile set 0.0 0.0 -2000.0 units box
fix             2 all nve
thermo          100
run 10
