# LAMMPS input script for simulating spall failure on Nb single crystals

# Initialization
units metal
dimension 3
boundary p p f
atom_style atomic

# System Construction
lattice bcc 3.300
region projectile block 0 20 0 20 0 20 units lattice
region target block 0 20 0 20 20 60 units lattice
region gap block 0 20 0 20 20 20.15 units lattice

create_box 2 all
create_atoms 1 region projectile
create_atoms 2 region target

mass 1 92.906
mass 2 92.906

# Potential
pair_style eam
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb

# Equilibration
velocity all create 300.0 123456 dist gaussian
fix 1 all nvt temp 300.0 300.0 0.1
run 10

# Apply impact velocity
velocity group projectile set 0.0 0.0 2000.0 units box

# Production Run
unfix 1
fix 2 all nve
run 10
