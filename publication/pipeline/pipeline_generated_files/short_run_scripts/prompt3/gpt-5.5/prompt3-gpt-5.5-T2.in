units metal
dimension 3
boundary p p s
atom_style atomic
variable a equal 3.300
variable gap equal 15.0
variable lx equal 20.0*${a}
variable ly equal 20.0*${a}
variable lz equal 60.0*${a}+${gap}
variable vimpact equal 20.0
lattice bcc ${a} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region box block 0.0 ${lx} 0.0 ${ly} 0.0 ${lz} units box
create_box 2 box
region projectile_region block 0.0 20.0 0.0 20.0 0.0 20.0 units lattice
region target_region block 0.0 20.0 0.0 20.0 20.0 60.0 units lattice
create_atoms 1 region projectile_region
create_atoms 2 region target_region
group projectile type 1
group target type 2
mass 1 92.90638
mass 2 92.90638
pair_style eam/alloy
pair_coeff * * /scratch/gilbreth/holbrooe/LAMMPS-AST/publication/potentials/prompt3.potential Nb Nb
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
thermo 1000
thermo_style custom step time temp pe ke etotal press pxx pyy pzz
thermo_modify lost error flush yes
velocity all create 300.0 4928459 mom yes rot yes dist gaussian
fix equilibration all nvt temp 300.0 300.0 0.1
reset_timestep 0
run 10
velocity projectile set NULL NULL ${vimpact} sum yes units box
fix production all nve
reset_timestep 0
run 10
