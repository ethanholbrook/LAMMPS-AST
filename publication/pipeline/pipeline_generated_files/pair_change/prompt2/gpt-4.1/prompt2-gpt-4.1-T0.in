# Initialization
units           metal
atom_style      atomic
boundary        p p p

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# Potential

pair_style zero 10.0
pair_coeff * *
mass 1 27

# Miscellaneous
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 600.0 12345 mom yes rot yes dist gaussian

# Production Run
fix             1 all npt temp 300.0 2500.0 10.0 iso 1.0 1.0 1000.0
timestep        0.001
run 10
