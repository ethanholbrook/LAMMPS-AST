# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 4.05
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box

# Potential

pair_style zero 10.0
pair_coeff * *
mass 1 27

# Minimization
minimize        1.0e-4 1.0e-6 100 1000

# Equilibration with NPT ensemble
fix             1 all npt temp 300.0 300.0 0.1 iso 1.0 1.0 1.0

# Production Run
timestep        0.001
run 10
