# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# Potential
pair_style      eam
pair_coeff      * * ../../../potentials/prompt1.potential Ni

# Miscellaneous
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# Production Run
velocity        all create 600 12345 mom yes rot yes dist gaussian
fix             1 all npt temp 300.0 2500.0 0.1 iso 1.01325 1.01325 1.0
timestep        0.001
run             2200