# Initialization
units           metal
dimension       3
boundary        p p f
atom_style      atomic

# System Construction
lattice         bcc 3.300
region          projectile block 0 20 0 20 0 20 units lattice
create_box      2 projectile
create_atoms    1 region projectile

region          target block 0 20 0 20 22.5 102.5 units lattice
create_atoms    2 region target

mass            * 92.906

# Potential
pair_style      eam
pair_coeff      * * ../../../potentials/prompt1.potential Nb

# Equilibration
velocity        all create 300.0 12345 mom yes dist gaussian
fix             1 all nvt temp 300.0 300.0 0.1
run             10000

# Impact Setup
velocity        1 set 0.0 0.0 -2000.0

# Production Run
unfix           1
fix             2 all nve
run             50000