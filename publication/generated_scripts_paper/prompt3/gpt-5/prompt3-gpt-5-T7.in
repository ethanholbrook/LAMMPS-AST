label Initialization
units metal
atom_style atomic
boundary p p s
newton on
special_bonds lj/coul 0.0 0.0 0.0
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001

label System_Construction
variable a equal 3.30
variable nx equal 20
variable ny equal 20
variable nzT equal 40
variable nzP equal 20
variable gap equal 15.0
variable xhi equal v_a*v_nx
variable yhi equal v_a*v_ny
variable zT equal v_a*v_nzT
variable zP equal v_a*v_nzP
variable zPbot equal v_zT+v_gap
variable zPtop equal v_zT+v_gap+v_zP
variable zhi equal v_zPtop
lattice bcc ${a} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0.0 ${xhi} 0.0 ${yhi} 0.0 ${zhi} units box
create_box 1 whole
mass 1 92.90637
region target block 0.0 ${xhi} 0.0 ${yhi} 0.0 ${zT} units box
region projectile block 0.0 ${xhi} 0.0 ${yhi} ${zPbot} ${zPtop} units box
create_atoms 1 region target
create_atoms 1 region projectile
group target region target
group projectile region projectile

label Potential
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Nb

label Miscellaneous
thermo 1000
thermo_style custom step temp pe ke etotal press pxx pyy pzz lx ly lz
velocity all create 300.0 492845 mom yes rot yes dist gaussian

label Production_Run
fix eq all nvt temp 300.0 300.0 0.1
variable nteq equal 100000
run ${nteq}
unfix eq
velocity projectile add 0.0 0.0 -20.0
fix prod all nve
variable nprod equal 200000
run ${nprod}