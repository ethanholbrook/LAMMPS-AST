print "Initialization"
units metal
dimension 3
boundary p p p
atom_style atomic
timestep 0.001

print "System Construction"
lattice fcc
region box block 0 1 0 1 0 1 units lattice
create_box 1 box
create_atoms 1 box
replicate 5 5 5

print "Potential"
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Al
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

print "Miscellaneous"
velocity all create 300 12345 mom yes rot no dist gaussian
thermo_style custom step temp press pe etotal
thermo 1000

print "Production Run"
fix 1 all npt temp 300 300 0.1 iso 1.01325 1.01325 1.0
run 500000
unfix 1