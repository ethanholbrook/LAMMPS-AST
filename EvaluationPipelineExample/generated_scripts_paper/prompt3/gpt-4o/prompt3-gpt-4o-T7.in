# LAMMPS Input Script for Nb Single Crystals Spall Failure Simulation

# Initialization
units           metal
atom_style      atomic
boundary        p p f

# System Construction
lattice         bcc 3.30  # Assuming Nb lattice constant
region          proj_box block 0 20 0 20 0 20
region          target_box block 0 20 0 20 21.5 101.5
create_box      2 proj_box
create_atoms    1 region proj_box
create_atoms    2 region target_box
replicate       20 20 20 region proj_box
replicate       20 20 40 region target_box

# Potential
pair_style      eam/alloy
pair_coeff      * * ../../../potentials/prompt1.potential Nb Nb

# Velocity and Temperature Setup
velocity        all create 300.0 12345 mom yes rot no
velocity        all set 0.0 0.0 2000.0 sum yes units box # Impact velocity along [001]

# Equilibration
fix             1 all nvt temp 300.0 300.0 0.1
timestep        0.001
run             100000  # 100 ps

# Production Run
unfix           1
fix             2 all nve
timestep        0.001
run             100000  # Simulate the impact and subsequent dynamics