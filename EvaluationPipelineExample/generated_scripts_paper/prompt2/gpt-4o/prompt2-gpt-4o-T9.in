# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# System Construction
lattice         fcc 3.52
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# Potential
pair_style      eam/cubic
pair_coeff      * * ../../../potentials/prompt1.potential Ni

# Miscellaneous
mass            1 58.6934
velocity        all create 600.0 12345 mom yes dist gaussian
neighbor        2.0 bin
neigh_modify    delay 10

# Production Run
fix             1 all npt temp 300.0 2500.0 100.0 iso 1.0 1.0 1000.0
timestep        0.001
thermo          100
run             220000