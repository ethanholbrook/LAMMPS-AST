print "Initialization"
units metal
atom_style atomic
boundary p p p
timestep 0.001
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

print "System Construction"
lattice fcc 3.52
region box block 0 1 0 1 0 1 units lattice
create_box 1 box
create_atoms 1 box
replicate 10 10 10

print "Potential"
mass 1 58.6934
pair_style eam/alloy
pair_coeff * * ../../../potentials/prompt1.potential Ni

print "Miscellaneous"
velocity all create 600 87287 mom yes rot yes dist gaussian
reset_timestep 0
thermo 1000
thermo_style custom step temp press pe ke etotal

print "Production Run"
fix 1 all npt temp 300 2500 1 iso 1.0 1.0 1
run 220000
unfix 1