units metal
dimension 3
boundary p p m
atom_style atomic
run_style verlet
lattice bcc 3.3 origin 0 0 0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 66 0 66 0 243 units box
create_box 2 whole
region proj_build block 0 19.999999 0 19.999999 0 19.999999 units lattice
create_atoms 1 region proj_build
group projectile type 1
region targ_build block 0 19.999999 0 19.999999 0 39.999999 units lattice
create_atoms 2 region targ_build
group target type 2
mass 1 92.90638
mass 2 92.90638
pair_style eam/fs
pair_coeff * * ../../../potentials/prompt1.potential Nb Nb
neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
thermo 1000
thermo_style custom step time temp pe ke etotal lx ly lz atoms
thermo_modify flush yes
velocity all create 300 4928459 mom yes rot no dist gaussian
dump deq all custom 1000 equilibration.lammpstrj id type x y z vx vy vz
dump_modify deq sort id
fix eq all nvt temp 300 300 0.1
run 100000
velocity all zero linear
reset_timestep 0
velocity projectile set 0 0 20 sum yes units box
dump dprod all custom 1000 impact.lammpstrj id type x y z vx vy vz
dump_modify dprod sort id
fix prod all nve
run 100000
write_data spall_final.data
