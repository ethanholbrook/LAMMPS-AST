units metal
dimension 3
boundary p p s
atom_style atomic
run_style verlet
lattice bcc 3.3004 origin 0 0 0 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 66.008 0 66.008 -0.1 213.124 units box
create_box 1 whole
mass 1 92.90637
region projectile block 0 66.008 0 66.008 0 66.008 units box
region target block 0 66.008 0 66.008 66.008 198.024 units box
create_atoms 1 region projectile
create_atoms 1 region target
group projectile region projectile
group target region target
pair_style eam/fs
pair_coeff * * ../../../potentials/prompt1.potential Nb
neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
thermo 1000
thermo_style custom step time atoms temp pe ke etotal press pxx pyy pzz lx ly lz
thermo_modify flush yes
velocity all create 300 4928459 mom yes rot no dist gaussian loop geom
fix eq all nvt temp 300 300 0.1
dump deq all custom 1000 equilibration.lammpstrj id type x y z vx vy vz
dump_modify deq sort id
run 100000
reset_timestep 0
velocity projectile add 0 0 20 units box
fix prod all nve
dump dprod all custom 1000 impact.lammpstrj id type x y z vx vy vz
dump_modify dprod sort id
run 100000
