units metal
dimension 3
boundary p p s
atom_style atomic
run_style verlet
variable alat equal 3.3004
variable nx equal 20
variable ny equal 20
variable nzt equal 40
variable nzp equal 20
variable gap equal 15.0
variable vimpact equal -20.0
variable dt equal 0.001
variable teq equal 100.0
variable tprod equal 100.0
variable neq equal round(v_teq/v_dt)
variable nprod equal round(v_tprod/v_dt)
variable lx equal v_nx*v_alat
variable ly equal v_ny*v_alat
variable zthi equal v_nzt*v_alat
variable zplo0 equal v_zthi
variable zphi0 equal v_zplo0+v_nzp*v_alat
variable zshift equal v_gap
variable zplo equal v_zplo0+v_zshift
variable zphi equal v_zphi0+v_zshift
variable lz equal v_zphi
lattice bcc ${alat} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region whole block 0 ${lx} 0 ${ly} 0 ${lz} units box
create_box 1 whole
region target block 0 ${lx} 0 ${ly} 0 ${zthi} units box
region projectile_init block 0 ${lx} 0 ${ly} ${zplo0} ${zphi0} units box
create_atoms 1 region target
create_atoms 1 region projectile_init
group target region target
group projectile region projectile_init
pair_style eam/fs
pair_coeff * * /home/holbrooe/LAMMPS-AST/EvaluationPipelineExample/potentials/prompt3.potential Nb
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
timestep ${dt}
velocity all create 300.0 4928459 mom yes rot no dist gaussian
velocity all zero linear
thermo 1000
thermo_style custom step time atoms temp pe ke etotal press pxx pyy pzz lx ly lz
thermo_modify norm no
dump 1 all custom 1000 spall.lammpstrj id type x y z vx vy vz
dump_modify 1 sort id
fix 1 all nvt temp 300.0 300.0 0.1
run 10
velocity target zero linear
velocity projectile zero linear
velocity projectile add 0.0 0.0 ${vimpact} units box
reset_timestep 0
fix 2 all nve
run 10
