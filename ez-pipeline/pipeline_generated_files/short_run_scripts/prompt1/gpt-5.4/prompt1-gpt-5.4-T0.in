units metal
dimension 3
boundary p p p
atom_style atomic
run_style verlet
variable a equal 4.05
variable temp equal 300.0
variable press equal 1.01325
variable tdamp equal 0.1
variable pdamp equal 1.0
variable dt equal 0.001
variable seed equal 4928459
lattice fcc ${a}
region box block 0 1 0 1 0 1 units lattice
create_box 1 box
create_atoms 1 box
replicate 5 5 5
mass 1 26.9815385
pair_style eam/alloy
pair_coeff * * /home/holbrooe/LAMMPS-AST/EvaluationPipelineExample/potentials/prompt1.potential Al
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
velocity all create ${temp} ${seed} mom yes rot no dist gaussian
timestep ${dt}
reset_timestep 0
thermo 1000
thermo_style custom step time temp press pe ke etotal enthalpy vol lx ly lz
fix 1 all npt temp ${temp} ${temp} ${tdamp} iso ${press} ${press} ${pdamp}
run 10
