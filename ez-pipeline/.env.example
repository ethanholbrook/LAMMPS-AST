# Necessary for script generation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override if you want the slower, higher-compute OpenAI variant:
# OPENAI_MODEL=gpt-5.4-pro

# Optional if you want more than one sample per prompt/model:
LAMMPS_PIPELINE_TRIALS=10

# Optional LAMMPS execution settings:
# Set USE_LAMMPS_MODULE_LOAD=0 on local machines that do not use environment modules.
USE_LAMMPS_MODULE_LOAD=1

# Direct path to the LAMMPS executable. On local machines, point this to your installed `lmp`.
LAMMPS_EXECUTABLE=/apps/spack/gilbreth-r9/apps/lammps/20240829-gcc-11.5.0-bsocngl/bin/lmp

# Module command used on cluster systems when USE_LAMMPS_MODULE_LOAD=1.
LAMMPS_MODULE_LOAD=module load lammps/20240829 >/dev/null 2>&1
